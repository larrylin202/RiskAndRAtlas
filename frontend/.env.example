# ==============================================================================
# R&R Atlas - Frontend Environment Variables
# Copy this file to '.env' (or '.env.local') to configure your React app.
# ==============================================================================

# Backend API Base URL
# If using the Vite proxy (configured in vite.config.js), leave this as an empty string or '/api'.
# If calling Flask directly cross-origin: http://127.0.0.1:5000/api
VITE_API_BASE_URL=/api

# Map Tile Configuration
# Default OpenStreetMap tile layer (free, no token needed)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Default Fallback Coordinates (Centered on California if geolocation is denied)
VITE_DEFAULT_LAT=36.7783
VITE_DEFAULT_LNG=-119.4179
VITE_DEFAULT_ZOOM=6

# Optional: Mapbox Access Token (if using Mapbox tiles or Mapbox Search instead of Leaflet OSM)
VITE_MAPBOX_TOKEN=