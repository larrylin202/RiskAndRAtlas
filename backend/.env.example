# ==============================================================================
# R&R Atlas - Backend Environment Variables
# Copy this file to '.env' and fill in your actual credentials.
# Never commit .env (it's gitignored).
# ==============================================================================

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=replace_with_a_secure_random_secret_key

# CORS Settings (URL of your React frontend dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL + PostGIS) - see "Database Setup" in the README. Pick ONE:
#
# Option A - shared Supabase database (ask a teammate for the real URL).
# Use the Session pooler string (port 5432), not Direct or Transaction pooler.
# DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Option B - local Docker database (docker compose up -d at the repo root)
DATABASE_URI=postgresql+psycopg://rr:rr@localhost:5432/rr_atlas

# Background refresh of hazard feeds (services/refresh.py)
# AUTO_INGEST=true            # set to false to stop API requests from refreshing feeds
# INGEST_STALE_MINUTES=10     # refresh a feed when its last attempt is older than this

# In-Memory / Redis Caching (Optional for local dev)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=900

# External Agency APIs & Feeds
# NOAA NWS API requires a custom User-Agent with an email address
NOAA_USER_AGENT=(RiskAndResilienceAtlas/1.0, your_email@domain.com)

# EPA AirNow API Key (Request a free key at https://docs.airnowapi.org/)
AIRNOW_API_KEY=your_airnow_api_key_here

# USGS Earthquake API (Public unmetered REST endpoint, no key required)
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary

# FEMA National Flood Hazard Layer (NFHL) Service URL
FEMA_API_BASE_URL=https://hazards.fema.gov/gis/nfhl/rest/services/public/NFHL/MapServer

# Map Geocoding API (e.g., Mapbox or OpenStreetMap Nominatim)
GEOCODING_API_KEY=your_geocoding_token_if_using_mapbox
